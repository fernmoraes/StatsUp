# Supabase do StatsUp. Valores PÚBLICOS (vão dentro do app): a proteção dos
# dados vem das regras RLS do banco (supabase/migrations). Nunca coloque aqui a
# senha do banco nem a secret key.
EXPO_PUBLIC_SUPABASE_URL=https://ncooxtjouurzzvktxvib.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_AADme-yBqIBMivbqSAGuzg_8l_qjbCH
# Página para onde o link do e-mail de confirmação leva (pasta site/, GitHub Pages).
# Precisa estar em Supabase → Authentication → URL Configuration → Redirect URLs.
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://fernmoraes.github.io/StatsUp/
# Versão mínima/mais recente do app (site/version.json). Atualização obrigatória.
EXPO_PUBLIC_VERSION_URL=https://fernmoraes.github.io/StatsUp/version.json
# Política de privacidade (site/privacidade.html). Aceite obrigatório no cadastro.
