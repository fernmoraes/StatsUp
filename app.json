{
  "expo": {
    "name": "StatsUp",
    "slug": "StatsUp",
    "scheme": "statsup",
    "version": "1.0.1-beta",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0D0D",
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fernmoraes.statsup",
      "allowBackup": false,
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DE1C1D"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#DE1C1D"
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa2897e9-5e3a-4fea-9229-a2aa025739bc"
      }
    },
    "owner": "fernandonavajasmoraes"
  }
}
